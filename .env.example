# ── دیتابیس ──────────────────────────────────────────
# مقدار پیش‌فرض با docker-compose.yml توسعه سازگار است
DATABASE_URL=postgresql://alocapsule:alocapsule@localhost:5436/alocapsule?schema=public

# ── احراز هویت ───────────────────────────────────────
# حداقل ۳۲ کاراکتر تصادفی، مثلاً: openssl rand -base64 48
AUTH_SECRET=

# ── سایت ─────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── سئو ──────────────────────────────────────────────
# فقط true ⇒ سایت برای گوگل باز است. هر مقدار دیگر ⇒ robots.txt کامل بسته و
# همه‌ی صفحات noindex (SEO.md §۸.۳)
# توسعه: همیشه false
ALLOW_INDEXING=false

# ── پیامک (ملی پیامک) ────────────────────────────────
# melipayamak | console
# console فقط برای توسعه است؛ در production باید خطا بدهد
SMS_PROVIDER=console
MELIPAYAMAK_USERNAME=
# رمز عبور یا ApiKey پنل. اگر خطای -110 گرفتید، ApiKey لازم است.
# اگر خطای -109 گرفتید، IP سرور باید در پنل ملی پیامک مجاز (whitelist) شود.
MELIPAYAMAK_PASSWORD=
# در صورت نیاز به ارسال غیرالگویی
MELIPAYAMAK_SENDER_NUMBER=
# شناسه‌ی الگوها (bodyId، عدد) از پنل ملی پیامک
# الگوی OTP باید دقیقاً یک متغیر داشته باشد: خود کد تأیید
SMS_PATTERN_OTP=
SMS_PATTERN_ORDER_PLACED=
SMS_PATTERN_PAYMENT_APPROVED=
SMS_PATTERN_PAYMENT_REJECTED=
SMS_PATTERN_ORDER_SHIPPED=
SMS_PATTERN_ORDER_CANCELED=
SMS_PATTERN_ADMIN_RECEIPT_SUBMITTED=
SMS_PATTERN_ADMIN_WALLET_PAID=
# گیرنده‌ی پیامک‌های مدیر (رسید جدید، پرداخت با کیف پول)؛ از پنل هم قابل تغییر است
SMS_ADMIN_PHONE=

# ── ذخیره‌سازی فایل ──────────────────────────────────
# local | s3
STORAGE_DRIVER=local
# فقط برای STORAGE_DRIVER=s3 (آروان یا هر سرویس S3-compatible)؛ آدرس‌دهی path-style
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# اختیاری: منطقه‌ی امضا (پیش‌فرض us-east-1؛ اگر سرویس منطقه‌ی مشخص می‌خواهد، آن را بگذارید)
S3_REGION=
# اختیاری: پایه‌ی آدرس عمومی تصاویر (دامین CDN یا virtual-host)؛ پیش‌فرض S3_ENDPOINT/S3_BUCKET
# دسترسی خواندن عمومی (public read) باید روی خود bucket فعال باشد.
S3_PUBLIC_URL=
# اختیاری: پوشه‌ی فایل‌های خصوصی (رسیدهای پرداخت) روی دیسک سرور، بیرون از public.
# مستقل از STORAGE_DRIVER. پیش‌فرض: ./storage/private — در Docker روی volume قرار گیرد.
PRIVATE_STORAGE_DIR=

# ── seed ─────────────────────────────────────────────
# شماره‌ی موبایل ادمین اولیه
ADMIN_SEED_PHONE=09xxxxxxxxx
