# ─────────────────────────────────────────────────────────────
# متغیرهای production (docker-compose.prod.yml)
#   cp .env.production.example .env.production  ← و همه‌ی مقادیر را پر کنید
# این فایل هرگز commit نشود.
# ─────────────────────────────────────────────────────────────

# ── دامنه و HTTPS (Caddy) ────────────────────────────
DOMAIN=alocapsule.ir
NEXT_PUBLIC_SITE_URL=https://alocapsule.ir

# ── سئو ──────────────────────────────────────────────
# فقط true ⇒ سایت برای گوگل باز است. هر مقدار دیگر ⇒ robots.txt کامل بسته و
# همه‌ی صفحات noindex (SEO.md §۸.۳)
# 🔴 هنگام انتشار نهایی روی سرور اصلی true کنید؛ سرور تست همیشه false
ALLOW_INDEXING=false
# پورت‌های Caddy روی میزبان (پیش‌فرض 80/443)
HTTP_PORT=80
HTTPS_PORT=443

# ── دیتابیس ──────────────────────────────────────────
# DATABASE_URL در compose از همین‌ها ساخته می‌شود
POSTGRES_USER=alocapsule
POSTGRES_DB=alocapsule
# رمز قوی تصادفی: openssl rand -base64 32 | tr -d '/+='
POSTGRES_PASSWORD=

# ── امنیت ────────────────────────────────────────────
# حداقل ۳۲ کاراکتر تصادفی: openssl rand -base64 48
AUTH_SECRET=
# کلید بازسازی کش صفحات پس از استقرار (حداقل ۳۲ کاراکتر)
REVALIDATE_SECRET=

# ── پیامک (ملی پیامک) ────────────────────────────────
# در production فقط melipayamak (console خطا می‌دهد)
SMS_PROVIDER=melipayamak
MELIPAYAMAK_USERNAME=
MELIPAYAMAK_PASSWORD=
MELIPAYAMAK_SENDER_NUMBER=
SMS_PATTERN_OTP=
SMS_PATTERN_ORDER_PLACED=
SMS_PATTERN_PAYMENT_APPROVED=
SMS_PATTERN_PAYMENT_REJECTED=
SMS_PATTERN_ORDER_SHIPPED=
SMS_PATTERN_ORDER_CANCELED=
SMS_PATTERN_ADMIN_RECEIPT_SUBMITTED=
SMS_PATTERN_ADMIN_WALLET_PAID=
# گیرنده‌ی پیامک‌های مدیر (رسید جدید، پرداخت با کیف پول)؛ از پنل هم قابل تغییر است
SMS_ADMIN_PHONE=

# ── فایل‌ها ──────────────────────────────────────────
# local: تصاویر محصول روی volume «uploads»؛ رسیدها همیشه روی volume «private_files»
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=
S3_PUBLIC_URL=

# ── بکاپ ─────────────────────────────────────────────
# پوشه‌ی بکاپ روی میزبان، ساعت اجرا (تهران) و مدت نگهداری
BACKUP_PATH=./backups
BACKUP_HOUR=03
BACKUP_RETENTION_DAYS=14

# ── seed اولیه (یک‌بار) ───────────────────────────────
ADMIN_SEED_PHONE=09xxxxxxxxx

# ── build ────────────────────────────────────────────
# اگر registry.npmjs.org از سرور در دسترس نیست، میرور را بگذارید
NPM_REGISTRY=https://registry.npmjs.org/
# اگر دانلود موتورهای Prisma (binaries.prisma.sh) از سرور ممکن نیست
PRISMA_ENGINES_MIRROR=
